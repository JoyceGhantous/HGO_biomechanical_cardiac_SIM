// lancer ce code avec la commande suivante :  ff-mpirun -np 6 tests/ffddm_Dk.edp 

macro dimension() 2 // EOM     

load "hpddm"
include "ffddm.idp"

// ----------------------------------------------------------
// Maillage global : carré [0,1]^2 avec 50x50 éléments
// broadcast : envoie Th à tous les process avant la partition
// ----------------------------------------------------------
mesh ThGlobal = square(50, 50);
broadcast(processor(0, mpiCommWorld), ThGlobal);

// ----------------------------------------------------------
// Construction de la partition du maillage
// M  : préfixe de la décomposition
// ----------------------------------------------------------
ffddmbuildDmesh(M, ThGlobal, mpiCommWorld);

// ----------------------------------------------------------
// Espace éléments finis distribué P1 vectoriel 
// def/init : macros obligatoires pour ffddm 
// ----------------------------------------------------------
macro def(u)  u // EOM
macro init(u) u   // EOM
ffddmbuildDfespace(Vh, M, real, def, init, P1);

// ----------------------------------------------------------
// Récupération des poids de partition de l'unité Di
// VhDk[mpirank] : vecteur Di local au process courant
// Di[j] = poids du DDL j, vérifie Σ_i Di[j] = 1
// pour tout DDL j partagé entre sous-domaines
// ----------------------------------------------------------
VhVhi def(di);
di[] = VhDk[mpirank];

// ----------------------------------------------------------
// Test 1 : intégrale AVEC pondération Di
//  - chaque point de l'overlap est compté une seule fois
//  - résultat = aire exacte du domaine
// ----------------------------------------------------------
real airlocal, airSum, airSum2;
airlocal = int2d(MThi)(di);                              // contribution locale pondérée
mpiAllReduce(airlocal, airSum, mpiCommWorld, mpiSUM);    // somme globale

// ----------------------------------------------------------
// Test 2 : intégrale SANS pondération
// → les points dans l'overlap sont comptés plusieurs fois
// → résultat > aire exacte (double comptage)
// ----------------------------------------------------------
airlocal = int2d(MThi)(1.);                              // contribution locale 
mpiAllReduce(airlocal, airSum2, mpiCommWorld, mpiSUM);   // somme globale

// ----------------------------------------------------------
// Affichage des résultats (sur process 0 uniquement)
// ----------------------------------------------------------
if (mpirank == 0) {
    cout << " Sans Di (double ddl dans le halo) = " << airSum2 << endl;
    cout << " Avec Di (pondere)                 = " << airSum  << endl;
    cout << " Aire exacte (maillage globale)    = " << int2d(ThGlobal)(1.0) << endl;
}
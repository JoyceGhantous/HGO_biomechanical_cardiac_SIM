// -------------------------------------------------------------------
//  TEST de En, DEn, DDEn en un point et dans des directions choisis
// -------------------------------------------------------------------

include "../src/2D_case/HyperElastic_2d.idp"
include "../src/2D_case/HyperElastic_Energy.idp"

real optQuasiIncomp = 0.;

// ---------- Maillage / espaces ----------
mesh Th = square(20,20);
fespace Sh(Th,P2);
fespace Vh(Th,[P2,P2]);

// ---------- Parametres materiau ----------
real nu1   = 1.;
real C0   = 1.;
real C1   = 1.;
real C2   = 1.;
real C3   = 1.;
real kappa = 1.;

Sh ax = 1.0;
Sh ay = 0.0;

macro WNH(d)    ( int2d(Th)( WNeoHook(I2d(d)) ) )           // EOM
macro WEX(d)    ( int2d(Th)( WExp(I2d(d)) ) )               // EOM
macro WFB(d, a) ( int2d(Th)( WExpFiber(I2d(d), I4(d, a))) ) // EOM
macro VOL(d)    ( int2d(Th)( WQuasiIncompln(I2d(d)) ))      // EOM

macro ENERGY(d, a) ( 
       nu1 * WNH(d)    + C0 * WEX(d) 
      + C2 * WFB(d, a) + kappa * VOL(d) 
      ) //

macro dENERGY(d, dd, a) ( int2d(Th)( dW2d(d, dd, a) ) ) //
macro ddENERGY(d, dd, ddd, a) ( int2d(Th)( ddW2d(d, dd, ddd, a) ) ) //

//-------------------------------------------------------------------
Vh [u,v] = [0.12*x, -0.08*y];
Vh [du,dv] = [0.03*x, -0.02*y];
Vh [d2u,d2v] = [-0.015*x, 0.025*y];

// -----------------------------
// Valeurs theoriques 
// -----------------------------
real EnTheo = 2.0891744042701954;
real dEnTheo = 0.047788645725143436;
real ddEnTheo = -0.012860443328617358;

// -----------------------------
// Valeurs numeriques 
// -----------------------------
real EnCode = ENERGY([u,v],[ax,ay]);
real dEnCode = dENERGY([u,v],[du,dv],[ax,ay]);
real ddEnCode = ddENERGY([u,v],[du,dv],[d2u,d2v],[ax,ay]);

// -----------------------------
// Erreurs
// -----------------------------
real errEn = abs(EnCode - EnTheo);
real errdEn = abs(dEnCode - dEnTheo);
real errddEn = abs(ddEnCode - ddEnTheo);

cout << "\n==============================" << endl;
cout << "Comparaison theorie / code" << endl;
cout << "==============================" << endl;

cout << "EnTheo   = " << EnTheo << endl;
cout << "EnCode   = " << EnCode << endl;
cout << "errEn    = " << errEn << endl;

cout << "\ndEnTheo  = " << dEnTheo << endl;
cout << "dEnCode  = " << dEnCode << endl;
cout << "errdEn   = " << errdEn << endl;

cout << "\nddEnTheo = " << ddEnTheo << endl;
cout << "ddEnCode = " << ddEnCode << endl;
cout << "errddEn  = " << errddEn << endl;

cout << "==============================\n" << endl;

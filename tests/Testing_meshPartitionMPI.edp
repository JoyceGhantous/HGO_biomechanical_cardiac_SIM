load "metis"
load "gmsh"

/*
    il faut lancer ce test avec mpirun -np 4 FreeFem++-mpi -wg meshPartitionMPI.edp
    A partir du repertoire ou il se trouve pour qu'il arrive a charger le maillage
    Si non - > "Cannot read the mesh file ../src/2D_case/Geometries/LR_gmsh_3.msh"

    -wg est pour la fenettre graphique 
*/

mesh Th = gmshload("../src/2D_case/Geometries/U_Shape_with_Holes.msh"); 

int nbparts = mpisize; 

fespace Ph(Th, P0);
Ph part;

if(mpisize > 1) metisdual(part[], Th, nbparts);
else            part[] = 0.0;

// C’est une décomposition sans recouvrement
mesh ThLoc = trunc(Th, abs(part - mpirank) < 1e-12);

// ThLoc.nt te donne directement le nombre de triangles
int elt = ThLoc.nt;
cout << "rank " << mpirank << " : " << elt << " triangles" << endl;

if(mpirank == 0)
    plot(part, value=1, fill=1, wait=1, cmm="partitioning");

// This code creates a non overlapping partition of the mesh
load "gmsh"
load "metis"

int nbparts = 4;

mesh Th = gmshload("../src/2D_case/Geometries/LR_gmsh_3.msh"); 

fespace Ph(Th, P0);
Ph pp;

metisdual(pp[], Th, nbparts);

plot(pp, value = 1, fill = 1, wait = 1, cmm = "partitioning");

for(int i = 0; i < nbparts; ++i) {
    Ph vis = (abs(pp - i) < 1e-12) * 10;
    int elt = 0;
    for(int j = 0; j < Ph.ndof; ++j)
        if(vis[][j] > 1e-12)
            ++elt;
    
    plot(vis, fill = 1, cmm = "partition " + i +", " + elt + " element(s)", wait = 1, nbiso = nbparts);
}
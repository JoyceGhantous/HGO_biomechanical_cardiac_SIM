// ============================================================
//  TEST de En, DEn, DDEn SUR LE CARRE [0,1]^2
//  avec plusieurs directions "aléatoires"
// ============================================================

include "../src/2D_case/HyperElastic_2d.idp"
include "../src/2D_case/HyperElastic_Energy.idp"

real optQuasiIncomp = 0.;
real nu1, C0, C1, C2, C3, kappa;
nu1 = 1.0;
C0 = 1.0; C1 = 1.0;
C2 = 1.0; C3 = 1.0;
kappa = 1.0;
real pi = acos(-1.0);

// ---------- Maillage / espaces ----------
mesh Th = square(30,30);
fespace Sh(Th,P2);
fespace Vh(Th,[P2,P2]);

// --------------------------------------
Sh ax = 1.0;
Sh ay = 1.0;

macro WNH(d)    ( int2d(Th)( WNeoHook(I2d(d)) ) )           // EOM
macro WEX(d)    ( int2d(Th)( WExp(I2d(d)) ) )               // EOM
macro WFB(d, a) ( int2d(Th)( WExpFiber(I2d(d), I4(d, a))) ) // EOM
macro VOL(d)    ( int2d(Th)( WQuasiIncompln(I2d(d)) ))      // EOM

macro ENERGY(d, a) ( 
       nu1 * WNH(d)    + C0 * WEX(d) 
      + C2 * WFB(d, a) + kappa * VOL(d) 
      ) //

macro dENERGY(d, dd, a) ( int2d(Th)( dW2d(d, dd, a) ) ) //
macro ddENERGY(d, dd, ddd, a) ( int2d(Th)( ddW2d(d, dd, ddd, a) ) ) //

// ---------- Variables ----------
Vh [u0,v0], [up,vp], [um,vm];
Vh [h1,h2], [k1,k2];

[u0, v0] = [ 0.020*sin(pi*x)*sin(pi*y) + 0.006*sin(2.0*pi*x)*sin(pi*y) + 0.003*x*(1.0-x), 
            -0.015*sin(pi*x)*sin(2.0*pi*y) + 0.004*cos(pi*x)*sin(pi*y) + 0.002*y*(1.0-y)];

real[int] epsList = [1e-2, 5e-3, 1e-3, 5e-4, 1e-4, 5e-5, 1e-5, 1e-6];

// -------------------------------------------------------- 

for (int itest = 0; itest < 5; ++itest)
{
    // Construire H et K avec coefficients aléatoires
    real a1 = 2.0*randreal1() - 1.0;
    real a2 = 2.0*randreal1() - 1.0;
    real a3 = 2.0*randreal1() - 1.0;
    real a4 = 2.0*randreal1() - 1.0;
    real a5 = 2.0*randreal1() - 1.0;
    real a6 = 2.0*randreal1() - 1.0;

    real b1 = 2.0*randreal1() - 1.0;
    real b2 = 2.0*randreal1() - 1.0;
    real b3 = 2.0*randreal1() - 1.0;
    real b4 = 2.0*randreal1() - 1.0;
    real b5 = 2.0*randreal1() - 1.0;
    real b6 = 2.0*randreal1() - 1.0;

    real c1 = 2.0*randreal1() - 1.0;
    real c2 = 2.0*randreal1() - 1.0;
    real c3 = 2.0*randreal1() - 1.0;
    real c4 = 2.0*randreal1() - 1.0;
    real c5 = 2.0*randreal1() - 1.0;
    real c6 = 2.0*randreal1() - 1.0;

    real d1 = 2.0*randreal1() - 1.0;
    real d2 = 2.0*randreal1() - 1.0;
    real d3 = 2.0*randreal1() - 1.0;
    real d4 = 2.0*randreal1() - 1.0;
    real d5 = 2.0*randreal1() - 1.0;
    real d6 = 2.0*randreal1() - 1.0;

    [h1, h2] = [ a1*sin(pi*x)*sin(pi*y) + a2*sin(2.0*pi*x)*sin(pi*y) + a3*sin(pi*x)*sin(2.0*pi*y) + a4*cos(pi*x)*sin(pi*y) + a5*x*(1.0-x) + a6*x*y, 
                 b1*sin(pi*x)*sin(pi*y) + b2*sin(2.0*pi*x)*sin(pi*y) + b3*sin(pi*x)*sin(2.0*pi*y) + b4*sin(pi*x)*cos(pi*y) + b5*y*(1.0-y) + b6*x*(1.0-y) ];

    [k1, k2] = [ c1*sin(pi*x)*sin(pi*y) + c2*sin(2.0*pi*x)*sin(pi*y) + c3*sin(pi*x)*sin(2.0*pi*y) + c4*cos(2.0*pi*x)*sin(pi*y) + c5*x*(1.0-x) + c6*x*y, 
                 d1*sin(pi*x)*sin(pi*y) + d2*sin(2.0*pi*x)*sin(pi*y) + d3*sin(pi*x)*sin(2.0*pi*y) + d4*sin(pi*x)*cos(2.0*pi*y) + d5*y*(1.0-y) + d6*(1.0-x)*y ];

    // Normalisation
    real nH = sqrt( int2d(Th)( h1^2 + h2^2 ) );
    real nK = sqrt( int2d(Th)( k1^2 + k2^2 ) );

    if (nH < 1e-14 || nK < 1e-14) {
        cout << "Erreur Test " << itest+1 << " direction quasi nulle." << endl;
        continue;
    }

    h1[] /= nH;   h2[] /= nH;
    k1[] /= nK;   k2[] /= nK;

    // ------------- Evaluation de chaque terme -------------
    real E0     = ENERGY([u0,v0],[ax,ay]);
    real dEH   = dENERGY([u0,v0],[h1,h2],[ax,ay]);
    real ddEKH = ddENERGY([u0,v0],[k1,k2],[h1,h2],[ax,ay]);
    real ddEHK = ddENERGY([u0,v0],[h1,h2],[k1,k2],[ax,ay]);

    real symAbs = abs(ddEKH - ddEHK);
    real symRel = symAbs / max(1.0, max(abs(ddEKH), abs(ddEHK)));

    cout << "----------------------------------------------------" << endl;
    cout << "TEST ALEATOIRE " << itest+1 << endl;
    cout << "E(U) = " << E0 << endl;
    cout << "dE(U)[H] = " << dEH << endl;
    cout << "ddE(U)[K,H] = " << ddEKH << endl;
    cout << "ddE(U)[H,K] = " << ddEHK << endl;
    cout << "Erreur symetrie abs = " << symAbs << endl;
    cout << "Erreur symetrie rel = " << symRel << endl;

    // --------------------------------------------------------
    // Test gradient
    // --------------------------------------------------------
    real errPrevG = -1.0;
    real epsPrevG = -1.0;

    cout << "  [Gradient]" << endl;
    for (int j = 0; j < epsList.n; ++j)
    {
        real eps = epsList[j];

        [up,vp] = [u0,v0] + eps*[h1,h2];
        [um,vm] = [u0,v0] - eps*[h1,h2];

        real Ep = ENERGY([up,vp],[ax,ay]);
        real Em = ENERGY([um,vm],[ax,ay]);

        real fd1 = (Ep - Em)/(2.0*eps);

        real absErrG = abs(fd1 - dEH);
        real relErrG = absErrG / max(1.0, max(abs(fd1), abs(dEH)));

        real slopeG = -999.0;
        if (errPrevG > 0.0 && absErrG > 0.0)
            slopeG = log(errPrevG/absErrG)/log(epsPrevG/eps);

        cout << "    eps = " << eps
             << "   absErr = " << absErrG
             << "   relErr = " << relErrG;
        if (slopeG > -100.0) cout << "   slope = " << slopeG;
        cout << endl;

        errPrevG = absErrG;
        epsPrevG = eps;
    }

    // --------------------------------------------------------
    // Test Hessienne
    // --------------------------------------------------------
    real errPrevH = -1.0;
    real epsPrevH = -1.0;

    cout << "  [Hessienne]" << endl;
    for (int j = 0; j < epsList.n; ++j)
    {
        real eps = epsList[j];

        [up,vp] = [u0,v0] + eps*[k1,k2];
        [um,vm] = [u0,v0] - eps*[k1,k2];

        real dEp = dENERGY([up,vp],[h1,h2],[ax,ay]);
        real dEm = dENERGY([um,vm],[h1,h2],[ax,ay]);

        real fd2 = (dEp - dEm)/(2.0*eps);

        real absErrH = abs(fd2 - ddEKH);
        real relErrH = absErrH / max(1.0, max(abs(fd2), abs(ddEKH)));

        real slopeH = -999.0;
        if (errPrevH > 0.0 && absErrH > 0.0)
            slopeH = log(errPrevH/absErrH)/log(epsPrevH/eps);

        cout << "    eps = " << eps
             << "   absErr = " << absErrH
             << "   relErr = " << relErrH;
        if (slopeH > -100.0) cout << "   slope = " << slopeH;
        cout << endl;

        errPrevH = absErrH;
        epsPrevH = eps;
    }

    cout << endl;
}

include "HyperElastic_3d.idp"

///////// W(I) = nu1 ( I1 * I3^(-1/3) - 3 ) /////////

macro WNeoHook(I1, I3) ( I1 * (I3^(-1./3.)) - 3. ) //

macro dWNeoHook(I1, I3, dI1, dI3) (  (I3^(-1./3.)) * dI1 
		 				+ I1 * (-1./3.) * (I3^(-4./3.)) * dI3 )  //

macro ddWNeoHook(I1, I3, dI1, dI3, ddI1, ddI3) ( - (1./3.) * (I3^(-4./3.)) * dI1 * ddI3 
								- (1./3.) * (I3^(-4./3.)) *  dI3 * ddI1
		  					   + (4./9.) * I1 * (I3^(-7./3.)) * dI3 * ddI3 )  //

///////// W(I) = nu2 ( I2 * I3^(-2/3) - 3 ) /////////

macro WMooneyRivlin(I2, I3) ( I2 * (I3^(-2./3.)) - 3. ) //

macro dWMooneyRivlin(I2, I3, dI2, dI3) ( dI2 * I3^(-2./3.)  
							 - (2./3.) * I2 * ( I3^(-5./3.) ) * dI3 ) //

macro ddWMooneyRivlin(I2, I3, dI2, dI3, ddI2, ddI3) ( - (2./3.) * I3^(-5./3.) * (dI2 * ddI3 + dI3 * ddI2)
            					  	                  + (10./9.) * I2 * I3^(-8./3.) * dI3 * ddI3 ) //

///////// W(I) = Cst0 * exp ( Cst1 * ( I1 * I3^(-1/3) - 3 )^2 ) /////////

macro WExp(I1, I3) ( exp( Cst1 * ( WNeoHook(I1, I3) )^2 ) ) //

macro dWExp(I1, I3, dI1, dI3) ( 2. * Cst1 * (WNeoHook(I1, I3))  * dWNeoHook(I1, I3, dI1, dI3) * WExp(I1, I3) ) //

macro ddWExp(I1, I3, dI1, dI3, ddI1, ddI3) ( 2. * Cst1 * (  dWNeoHook(I1, I3, ddI1, ddI3) * dWNeoHook(I1, I3, dI1, dI3)
				    	 			 					+ (WNeoHook(I1, I3)) * ( ddWNeoHook(I1, I3, dI1, dI3, ddI1, ddI3) 
									    				+  2. * Cst1 * dWNeoHook(I1, I3, dI1, dI3) * (WNeoHook(I1, I3)) * dWNeoHook(I1, I3, ddI1, ddI3) ) ) * WExp(I1, I3) ) //
													
///////// W(I) = Cst2 * exp ( Cst3 * ( I4 * I3^(-1/3) - 1 )^2 ) /////////

/////// Tools ////////

macro VVfibre(I3, dI3, I4, dI4) ( dI4 * (I3^(-1./3.)) - (1./3.) * I4 * (I3^(-4./3.)) * dI3 ) //

macro dUUfibre(I3, ddI3, I4, ddI4) ( ddI4 * (I3^(-1./3.)) + (-1./3.) * I4 * (I3^(-4./3.)) * ddI3 ) //

macro dVVfibre(I3, dI3, ddI3, I4, dI4, ddI4) (  (-1./3.) * dI4  * (I3^(-4./3.)) * ddI3 		   
	 										- (1./3.) * ddI4 * (I3^(-4./3.)) * dI3
											+ (4./9.) * I4   * (I3^(-7./3.)) * dI3 * ddI3 ) //

macro dWWfibre(I3, ddI3, I4, ddI4)(	2. * Cst3 * (I4 * (I3^(-1./3.)) - 1.) * dUUfibre(I3, ddI3, I4, ddI4) * exp( Cst3 * ( I4 * (I3^(-1./3.)) - 1. )^2 ) ) //

/////// END Tools /////////

macro WExpFiber(I3, I4) ( exp ( Cst3 * ( I4 * (I3^(-1./3.)) - 1. )^2 ) ) //

macro dWExpFiber(I3, I4, dI3, dI4) ( 2. * Cst3 * (I4 * (I3^(-1./3.)) - 1.) * VVfibre(I3, dI3, I4, dI4) * exp( Cst3 * ( I4 * (I3^(-1./3.)) - 1. )^2 ) ) //

macro ddWExpFiber(I3, I4, dI3, dI4, ddI3, ddI4) ( 2. * Cst3 * ( 
																dUUfibre(I3, ddI3, I4, ddI4) * VVfibre(I3, dI3, I4, dI4) 			 * WExpFiber(I3, I4)
				    						 				  + (I4 * (I3^(-1./3.)) - 1.) 			   * dVVfibre(I3, dI3, ddI3, I4, dI4, ddI4) * WExpFiber(I3, I4) 
											 				  + (I4 * (I3^(-1./3.)) - 1.) 			   * VVfibre(I3, dI3, I4, dI4) 			 * dWWfibre(I3, ddI3, I4, ddI4) 
														 )
											 ) //

////////// W(I_3) = k ( I3^0.5 - 1 - ln (I3^0.5) )  for quasi-incompressibility //////////

macro WQuasiIncompln(I3) ( I3^(0.5) - 1. - log( sqrt(I3) ) ) //	

macro dWQuasiIncompln(I3, dI3) ( 0.5 * ( ( I3^(-0.5) ) - ( I3^(-1) ) ) * dI3 ) //

macro ddWQuasiIncompln(I3, dI3, ddI3) ( (-0.25 * (I3^(-1.5)) + 0.5 * (I3^(-2)) ) * dI3 * ddI3) //

/*
   ---------------------------------------------------------------------
   Derivatives, precomputed-invariant version.
   ---------------------------------------------------------------------
*/

macro W3d(d, I1u, I2u, I3u, I4u) (
		  nu1  * WNeoHook(I1u, I3u)  
		+ nu2 * WMooneyRivlin(I2u, I3u) 
	  	+ Cst0  * WExp(I1u, I3u) 
		+ Cst2  * WExpFiber(I3u, I4u) 
	  	+ kappa * WQuasiIncompln(I3u) ) //

macro dW3d(d, dd, a, Cu, I1u, I2u, I3u, I4u) (
		  nu1  * dWNeoHook(I1u, I3u, dI1(d, dd, Cu), dI3(d, dd, Cu))  
		+ nu2 * dWMooneyRivlin(I2u, I3u, dI2(d, dd, Cu), dI3(d, dd, Cu)) 
	  	+ Cst0  * dWExp(I1u, I3u, dI1(d, dd, Cu), dI3(d, dd, Cu)) 
		+ Cst2  * dWExpFiber(I3u, I4u, dI3(d, dd, Cu), dI4(d, dd, a, Cu)) 
	  	+ kappa * dWQuasiIncompln(I3u, dI3(d, dd, Cu)) ) //

macro ddW3d(d, dd, ddd, a, Cu, I1u, I2u, I3u, I4u) (
		  nu1  * ddWNeoHook(I1u, I3u, dI1(d, dd, Cu), dI3(d, dd, Cu), dI1(d, ddd, Cu), dI3(d, ddd, Cu)) 
		+ nu1  * dWNeoHook(I1u, I3u, ddI1(d, dd, ddd), ddI3(d, dd, ddd, Cu))  
   		+ nu2  * ddWMooneyRivlin(I2u, I3u, dI2(d, dd, Cu), dI3(d, dd, Cu), dI2(d, ddd, Cu), dI3(d, ddd, Cu))
		+ nu2  * dWMooneyRivlin(I2u, I3u, ddI2(d, dd, ddd, Cu), ddI3(d, dd, ddd, Cu))
   		+ Cst0 * ddWExp(I1u, I3u, dI1(d, dd, Cu), dI3(d, dd, Cu), dI1(d, ddd, Cu), dI3(d, ddd, Cu))  			
		+ Cst0 * dWExp(I1u, I3u, ddI1(d, dd, ddd), ddI3(d, dd, ddd, Cu)) 
   		+ Cst2 * ddWExpFiber(I3u, I4u, dI3(d, dd, Cu), dI4(d, dd, a, Cu), dI3(d, ddd, Cu), dI4(d, ddd, a, Cu)) 
		+ Cst2 * dWExpFiber(I3u, I4u, ddI3(d, dd, ddd, Cu), ddI4(d, dd, ddd, a))
   		+ kappa *  ddWQuasiIncompln(I3u, dI3(d, dd, Cu), dI3(d, ddd, Cu)) 
		+ kappa * dWQuasiIncompln(I3u, ddI3(d, dd, ddd, Cu)) ) //

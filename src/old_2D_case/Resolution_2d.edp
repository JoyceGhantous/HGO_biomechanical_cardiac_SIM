include "parameters.edp"

include "HyperElastic_2d.idp"
include "HyperElastic_Energy.idp"
include "Domain.edp"

include "../tools.idp"

ofstream en("../../res/old_2D_case/energy.txt"); 
ofstream LGe("../../res/old_2D_case/L2Gradenergy.txt"); 
ofstream vol("../../res/old_2D_case/volume.txt");
ofstream Jac("../../res/old_2D_case/jacobian.txt");

real t0 = clock();

PrintMesh(Th, 2);

// -----------------------------
// FE spaces and unknowns
// -----------------------------

fespace Sh(Th, P1);
fespace Vh(Th, [P1, P1]);

Vh [du1, du2] = [0, 0]; // Delta u        
Vh [un, vn] = [0, 0];   // u_n at the n-th iteration 

// -----------------------------
// Energy and its first derivative
// -----------------------------

macro ENERGY(u1, u2) ( 
      int2d(Th)( W2d([u1,u2]) ) 
    - int2d(Th)( f1*u1 + f2*u2 ) 
    - int1d(Th, right)( g1*u1 + g2*u2 ) 
    - int1d(Th, inner)( g0*u1 + g0*u2 ) 
    - int1d(Th, outer)( g0*u1 + g0*u2 ) 
) //

macro dENERGY(u1, u2, u3, u4) ( 
      int2d(Th)( dW2d([u1, u2],[u3, u4]) )
      - int2d(Th)( f1*u3 + f2*u4 )
      - int1d(Th, right)( g1*u3 + g2*u4 )
      - int1d(Th, inner)( g0*u3 + g0*u4 )
      - int1d(Th, outer)( g0*u3 + g0*u4 )
) //

Vh [uu, vv], [w, s];
varf vGrad([uu, vv],[w, s]) =
      int2d(Th)( dW2d([un,vn],[w, s]) )
    - int2d(Th)( f1*w + f2*s )
    - int1d(Th, right)( g1*w + g2*s )
    - int1d(Th, inner)( g0*w + g0*s )
    - int1d(Th, outer)( g0*w + g0*s )
    + on(left, uu=0, vv=0);

// -----------------------------
// Mass matrix for L2 norm 
// -----------------------------

varf vmass ([uu, vv], [w, s], solver=CG) = int2d(Th)(uu*w + vv*s);
matrix M = vmass(Vh, Vh);


// -----------------------------
// Problème Newton :
//    D2W = - (Dw - Fext)
//    => D2W + Dw - Fext = 0
// -----------------------------

Vh [v1, v2];
problem NonLin([du1, du2], [v1, v2])
      = int2d(Th)( ddW2d([un, vn], [du1, du2], [v1, v2])) // D2W
      + int2d(Th)( dW2d([un, vn], [v1, v2]) )             // DW 
      - int2d(Th)( f1*v1 + f2*v2 )                        //  - Fext     
      - int1d(Th, right)( g1*v1 + g2*v2 )
      - int1d(Th, inner)( g0*v1 + g0*v2 )
      - int1d(Th, outer)( g0*v1 + g0*v2 )
      + on(left, du1=0, du2=0);

// -----------------------------
// Newton + line-search
// -----------------------------

for (int i = 0; i < Nbmax; i++){
      
      cout << "---------------------------------------- \n" << endl;
      cout << "Iteration " << i << endl;

      // Sh eta = W2d([un,vn]);
      // mesh Th = adaptmesh(Th, eta, err=0.01, hmin=1e-3, hmax=0.05, nbvx=50000);

      // -----------------------------
      // Compute the total energy
      // -----------------------------
      real En = ENERGY(un, vn);
      cout << "The energy functional = " << En << endl;
      en << i << " " << En << endl;

      // -------------------------------------------------
      // Compute Jacobian determinant of the deformation
      // -------------------------------------------------
      Sh J;
      J = (1.0 + dx(un))*(1.0 + dy(vn)) - dx(vn)*dy(un);
      cout << "  min(J) = " << J[].min << "   max(J) = " << J[].max << endl;
      Jac << i << " " << J[].min << " " << J[].max << endl;
      if (J[].min < 0) {
            cout << "Negative Jacobian determinant detected! min(J) = " << J[].min << endl;
            break;
      }

      // -------------------------------------------------
      // Solve Newton system -> gives du1,du2
      // -------------------------------------------------
      NonLin;    

      // --------------------------------------------------
      // Line search with Armijo condition
      // --------------------------------------------------

      real alpha = 1.0;
      real En0  = ENERGY(un, vn);
      real dEn0 = dENERGY(un, vn, du1, du2);
      real c = 1e-5;

      // sécurité : si pas une direction de descente, on corrige (optionnel mais utile)
      if (dEn0 >= 0) {
            cout << "Warning: Newton direction not descent (dEn0=" << dEn0 << ") -> stop \n" << endl;
            break;
      }

      Vh [utry, vtry];
      Sh Jtry;

      while (alpha > tol) {

            [utry, vtry] = [un, vn] + alpha * [du1, du2];

            real EnTry = ENERGY(utry, vtry);

            cout  << "  alpha=" << alpha
                  << "  EnTry-En0=" << (EnTry-En0)
                  << "  RHS=" << (c*alpha*dEn0) << endl;

            // -------------------------------------------------
            // Update solution
            // Armijo: E(un + alpha * delta un) <= E(un) + c * alpha * dE(un)[delta un]
            // -------------------------------------------------
            if (EnTry <= En0 + c * alpha * dEn0) {
                  [un, vn] = [utry, vtry];
                  break;
            }

            alpha *= 0.5;

      }

      if (alpha <= tol) {
          cout << "Line-search failed (alpha too small). Stopping.\n" << endl ;
          break;
      }

      cout << "  accepted alpha = " << alpha << endl;
      
      // -----------------------------
      // Stopping criterias
      // -----------------------------
      Vh [d1eff, d2eff] = alpha * [du1, du2];

      // norme sup (inf-norm discrète)
      real duInf = max( max(abs(d1eff[].min), abs(d1eff[].max)),
                        max(abs(d2eff[].min), abs(d2eff[].max)) );
      cout << "  ||alpha*du||_inf = " << duInf << endl;

      if (duInf < tol) {
            cout << "Converged: step inf-norm below tol.\n" << endl;
            break;
      }

      // --------------------------------------------------
      // Compute the L2 norm of the derivative of the energy
      // --------------------------------------------------
      real[int] G = vGrad(0, Vh);   
      real[int] z = M^-1 * G;       
      real gradL2 = sqrt( G' * z );

      cout << " ||grad E||_L2 = " << gradL2 << endl;
      LGe << i << " " << gradL2 << endl;

      if (gradL2 < tol) {
          cout << "Converged: gradient below tol.\n"<< endl;
          break;
      }

}

// ---------------------------------------------------------------
// Mesh adaptation and movement based on the displacement field
// ---------------------------------------------------------------

Sh eta = W2d([un,vn]);
mesh Thm = adaptmesh(Th, eta, err=0.01, hmin=1e-3, hmax=0.05, nbvx=50000);

// Interpolate displacement onto Thm
fespace Vhm(Thm,[P1,P1]);
Vhm [um, vm] = [un, vn];

for (int ii = 0; ii < Nsteps; ii++) {
    vol << ii << " " << Area(Thm) << endl;

    real step = 1.0 / Nsteps;
    real minS = checkmovemesh(Thm, [x + step*um, y + step*vm]);

    while (minS < tol) {
      // si minS < 0, il y a des triangles inverses
      cout << "minS = " << minS << endl;
      step *= 0.9;
      minS = checkmovemesh(Thm, [x + step*um, y + step*vm]);
      if (step < tol) { cout << "Step too small, stop moving mesh.\n"; break; }
    }

//     if (step < tol) break;

    Thm = movemesh(Thm, [x + step*um, y + step*vm]);

    // après movemesh, le maillage a changé 
    // um, vm sont encore liés à l’ancien espace Vhm
    // -> il faut "transporter" um,vm sur le nouveau Thm
    fespace Vhm2(Thm,[P1,P1]);
    Vhm2 [um2, vm2] = [um, vm]; // interpolation sur nouveau Thm
    [um, vm] = [um2, vm2];

    plot(Thm);
}

plot(Thm, ps ="res/Final_mesh.eps");

// -----------------------------
// Post-processing
// -----------------------------

PrintMesh(Thm, 2);
PercentageAreaVariation(Th, Thm);

real mind = un[].min;
cout << "The minimum value of the displacement = " << mind << endl;
real maxd = un[].max;
cout << "The maximum value of the displacement = " << maxd << "\n" << endl;

real t1 = clock();
PrintTime(t1, t0);



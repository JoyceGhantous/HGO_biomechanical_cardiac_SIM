load "gmsh"
load "iovtk"
load "Element_P3" 
load "MUMPS"
include "getARGV.idp"

/*
    Parameters for the HGO transversely isotropic hyperelastic model
    used in Resolution.edp and EnergyDef.edp
*/

verbosity = 0; 

// ----------------------------------------------------------------

// options: 0 = quasi-incompressibility with ln
//          1 = quasi-incompressibility without ln

real optQuasiIncomp = 0.;

// Parameters for the HGO model
// nu1, nu2, C0, C1, C2, C3 and kappa are used in EnergyDef.edp
// There is not a nu2 in the 2D case
real nu1, C0, C1, C2, C3, kappa;
int caseId;

if (case == "0"){
    nu1 = 1.;
    C0 = 10.;
    C1 = 0.5;
    C2 = 15.;
    C3 = 0.9;
    kappa = 800.; 
    caseId = 0;
    }
if (case == "2009"){
    include "parameters/2D_case/HGO_2009.edp"
}
if (case == "2025"){
    include "parameters/2D_case/Chapelle-Fernandez_2025.edp"
}
if (case == "8"){
    include "parameters/2D_case/test8.edp"
}
if (case == "2006"){
    include "parameters/2D_case/Reduced_HGO.edp"
}


// ----------------------------------------------------------------

// Border conditions
real g0 = 0., g = 1.;

real theta = 0.25 * pi;
real g1 = g * cos(theta), g2 = - g * sin(theta);

// body forces
real f1 = 0., f2 = 0.;

// optimization parameters for the Newton method

real alpha = 0.1;
real alphaMax = 1., alphaMin = 0.0001;

int Nbmax = 500;
real tol = 1e-7, Jtol = 1e-6; 

// for movemesh
int Nsteps = 100;

// ----------------------------------------------------------------

// basic path
string res = "res/2D_case/Test_" + testId + "/";

// Create all subfolders (including new ones)
exec("mkdir -p " + res + "en");
exec("mkdir -p " + res + "grad");
exec("mkdir -p " + res + "vol");
exec("mkdir -p " + res + "jac");
exec("mkdir -p " + res + "mesh");
exec("mkdir -p " + res + "fiber");

// Data outputs — unchanged subfolders
ofstream en  (res + "en/energy"          + caseId + ".txt");
ofstream LGe (res + "grad/L2Gradenergy"  + caseId + ".txt");
ofstream vol (res + "vol/volume"         + caseId + ".txt");
ofstream Jac (res + "jac/jacobian"       + caseId + ".txt");

// ----------------------------------------------------------------

cout << "Test case " + caseId + " : \n " << endl;
cout << "nu1 = " << nu1 << endl; 
cout << "C0 = " << C0 << ", C1 = " << C1 <<  endl; 
cout << "C2 = " << C2 << ", C3 = " << C3 <<  endl; 
cout << "kappa = " << kappa << " \n " << endl;  

// ----------------------------------------------------------------

cout << "Border conditions : g = "<< g << "-> Right & g = "<<  -g << "-> Left " << endl;
cout << "No body force \n" << endl;
cout << "Optimization parameters for the Newton method : \n" << endl;
cout << "Jtol     = " << Jtol     << endl;
cout << "alpha    = " << alpha    << endl;
cout << "alphaMax = " << alphaMax << endl;
cout << "alphaMin = " << alphaMin << endl;
cout << "Nbmax    = " << Nbmax    << endl;
cout << "tol      = " << tol      << endl;
cout << "For movemesh : Nsteps = " << Nsteps <<endl;
